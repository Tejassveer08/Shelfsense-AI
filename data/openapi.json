{
  "openapi": "3.1.0",
  "info": {
    "title": "ShelfSense API",
    "description": "Production-quality LLM-powered semantic book recommender API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Search Books",
        "operationId": "search_books_api_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/similar": {
      "post": {
        "tags": [
          "similar"
        ],
        "summary": "Get Similar Books",
        "operationId": "get_similar_books_api_similar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimilarRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/explain": {
      "post": {
        "tags": [
          "explain"
        ],
        "summary": "Explain Book",
        "operationId": "explain_book_api_explain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplainRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplainResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Chat Refine",
        "operationId": "chat_refine_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/book/{isbn13}": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Get Book By Isbn",
        "operationId": "get_book_by_isbn_api_book__isbn13__get",
        "parameters": [
          {
            "name": "isbn13",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Isbn13"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookItem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/galaxy": {
      "get": {
        "tags": [
          "galaxy"
        ],
        "summary": "Get Galaxy Nodes",
        "operationId": "get_galaxy_nodes_api_galaxy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalaxyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check Health",
        "operationId": "check_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookItem": {
        "properties": {
          "isbn13": {
            "type": "string",
            "title": "Isbn13"
          },
          "isbn10": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isbn10",
            "default": ""
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "authors": {
            "type": "string",
            "title": "Authors"
          },
          "categories": {
            "type": "string",
            "title": "Categories"
          },
          "raw_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Category",
            "default": ""
          },
          "thumbnail": {
            "type": "string",
            "title": "Thumbnail"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "published_year": {
            "type": "integer",
            "title": "Published Year"
          },
          "average_rating": {
            "type": "number",
            "title": "Average Rating"
          },
          "num_pages": {
            "type": "integer",
            "title": "Num Pages"
          },
          "ratings_count": {
            "type": "integer",
            "title": "Ratings Count"
          },
          "emotions": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Emotions"
          },
          "vibe_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Vibe Scores"
          },
          "galaxy_x": {
            "type": "number",
            "title": "Galaxy X",
            "default": 0.0
          },
          "galaxy_y": {
            "type": "number",
            "title": "Galaxy Y",
            "default": 0.0
          },
          "search_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Score"
          },
          "dense_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dense Score"
          },
          "bm25_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bm25 Score"
          },
          "matched_snippet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Snippet"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "ranking_explanation": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ranking Explanation"
          }
        },
        "type": "object",
        "required": [
          "isbn13",
          "title",
          "authors",
          "categories",
          "thumbnail",
          "description",
          "published_year",
          "average_rating",
          "num_pages",
          "ratings_count"
        ],
        "title": "BookItem"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "'user', 'assistant', or 'system'"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages"
          },
          "state": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "updated_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated Query"
          },
          "updated_filters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated Filters"
          },
          "updated_sliders": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated Sliders"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/BookItem"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "reply"
        ],
        "title": "ChatResponse"
      },
      "ExplainRequest": {
        "properties": {
          "isbn13": {
            "type": "string",
            "title": "Isbn13"
          },
          "query": {
            "type": "string",
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "isbn13",
          "query"
        ],
        "title": "ExplainRequest"
      },
      "ExplainResponse": {
        "properties": {
          "isbn13": {
            "type": "string",
            "title": "Isbn13"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "highlighted_snippet": {
            "type": "string",
            "title": "Highlighted Snippet"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "isbn13",
          "explanation",
          "highlighted_snippet",
          "confidence"
        ],
        "title": "ExplainResponse"
      },
      "Filters": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category",
            "description": "Simplified category filter"
          },
          "tone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tone",
            "description": "Emotional tone: joy, sadness, fear, anger, surprise, neutral"
          },
          "year_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year Min",
            "description": "Minimum published year"
          },
          "year_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year Max",
            "description": "Maximum published year"
          },
          "max_pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pages",
            "description": "Maximum number of pages"
          },
          "min_rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Rating",
            "description": "Minimum average rating (e.g. 3.5, 4.0)"
          }
        },
        "type": "object",
        "title": "Filters"
      },
      "GalaxyNode": {
        "properties": {
          "isbn13": {
            "type": "string",
            "title": "Isbn13"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "authors": {
            "type": "string",
            "title": "Authors"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "rating": {
            "type": "number",
            "title": "Rating"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "cover": {
            "type": "string",
            "title": "Cover"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "vibe_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Vibe Scores"
          },
          "emotions": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Emotions"
          }
        },
        "type": "object",
        "required": [
          "isbn13",
          "title",
          "authors",
          "category",
          "rating",
          "pages",
          "year",
          "cover",
          "x",
          "y",
          "vibe_scores",
          "emotions"
        ],
        "title": "GalaxyNode"
      },
      "GalaxyResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GalaxyNode"
            },
            "type": "array",
            "title": "Nodes"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "type": "object",
        "required": [
          "total",
          "nodes",
          "categories"
        ],
        "title": "GalaxyResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "indexed_books": {
            "type": "integer",
            "title": "Indexed Books"
          },
          "llm_provider": {
            "type": "string",
            "title": "Llm Provider"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          }
        },
        "type": "object",
        "required": [
          "status",
          "indexed_books",
          "llm_provider"
        ],
        "title": "HealthResponse"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Natural language search query"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Filters"
              },
              {
                "type": "null"
              }
            ]
          },
          "sliders": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VibeSliders"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 24
          },
          "rerank": {
            "type": "boolean",
            "title": "Rerank",
            "description": "Use cross-encoder reranker on top candidates",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/BookItem"
            },
            "type": "array",
            "title": "Results"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "applied_filters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Applied Filters"
          },
          "applied_sliders": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Applied Sliders"
          }
        },
        "type": "object",
        "required": [
          "results",
          "total",
          "query",
          "applied_filters",
          "applied_sliders"
        ],
        "title": "SearchResponse"
      },
      "SimilarRequest": {
        "properties": {
          "isbn13s": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Isbn13S",
            "description": "1-10 loved book ISBNs"
          },
          "ratings": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ratings",
            "description": "Optional ratings (1.0 - 5.0) per ISBN"
          },
          "modifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modifier",
            "description": "Contrast modifier (e.g. 'but happier', 'shorter')"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 12
          }
        },
        "type": "object",
        "required": [
          "isbn13s"
        ],
        "title": "SimilarRequest"
      },
      "SimilarResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/BookItem"
            },
            "type": "array",
            "title": "Results"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "'taste_profile' or 'contrast_mode'",
            "default": "taste_profile"
          },
          "attributed_to": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attributed To"
          },
          "modifier_applied": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modifier Applied"
          }
        },
        "type": "object",
        "required": [
          "results",
          "total"
        ],
        "title": "SimilarResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VibeSliders": {
        "properties": {
          "dark_light": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Dark Light",
            "description": "Dark (-1.0) <-> Light (+1.0)",
            "default": 0.0
          },
          "pacing": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Pacing",
            "description": "Fast-paced (-1.0) <-> Slow-burn (+1.0)",
            "default": 0.0
          },
          "cerebral_escapist": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Cerebral Escapist",
            "description": "Cerebral (-1.0) <-> Escapist (+1.0)",
            "default": 0.0
          },
          "length_scale": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Length Scale",
            "description": "Short (-1.0) <-> Epic (+1.0)",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "VibeSliders"
      }
    }
  }
}