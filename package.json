{
  "name": "shelfsense",
  "version": "2.0.0",
  "private": true,
  "description": "AI book discovery over the Goodreads catalogue — Next.js on Vercel + MongoDB Atlas Vector Search",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-model.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d mongo",
    "db:indexes": "py -3.11 scripts/setup_indexes.py",
    "model": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@vercel/functions": "^3.11.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "mongodb": "^7.9.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
