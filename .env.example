# ==========================================
# ShelfSense Configuration
# ==========================================

# Optional: Google Gemini API Key for dynamic LLM explanations & chat
# If left empty, ShelfSense automatically runs in high-precision Offline Fallback mode with zero external dependencies.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend settings
HOST=0.0.0.0
PORT=8000
CHROMA_PERSIST_DIR=data/chroma_db
DATA_PATH=data/books.csv

# Frontend settings
NEXT_PUBLIC_API_URL=http://localhost:8000
