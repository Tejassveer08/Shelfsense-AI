# ============================================================================
# ShelfSense configuration. Copy to .env.local for local development and add the
# same variables in Vercel → Project → Settings → Environment Variables.
# ============================================================================

# --- MongoDB (required) -----------------------------------------------------
# Atlas: Database → Connect → Drivers. Local: `docker compose up -d mongo` and use
#   mongodb://localhost:27017/?directConnection=true
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=shelfsense
# Must match the --vector-format the books were loaded with (float32 or int8).
VECTOR_FORMAT=float32

# --- Query embeddings (recommended) -----------------------------------------
# Searches embed the query with sentence-transformers/all-MiniLM-L6-v2 (same model as the index).
#   hf    → Hugging Face Inference API (free token: huggingface.co/settings/tokens) — use on Vercel
#   local → runs the model inside Node with @huggingface/transformers (local dev, no key)
#   auto  → hf when HF_TOKEN is set, otherwise local (off Vercel), otherwise keyword-only search
EMBEDDINGS_PROVIDER=auto
HF_TOKEN=

# --- AI (optional) ------------------------------------------------------------
# Groq (free tier, no card needed: console.groq.com/keys) powers the librarian chat, query
# understanding, explanations, fit verdicts and reader personas. Without a key everything still
# works with deterministic offline fallbacks.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
